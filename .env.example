# ───────── CareerPilot AI configuration ─────────
# Copy this file to `.env`. Every setting is OPTIONAL: with nothing set, the app runs in offline mode
# (templates + sample jobs). Never put real keys in code or commit `.env`.

# ── AI (optional) ──  free key: https://aistudio.google.com/apikey   (empty = offline templates)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Job sources ──  Remotive, RemoteOK, Arbeitnow and RSS need no key
JOB_PROVIDERS=remotive,remoteok,arbeitnow,rss,adzuna
JOB_RSS_FEEDS=https://weworkremotely.com/categories/remote-programming-jobs.rss
# Adzuna free key, best free source for India: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRIES=in,gb,us
MOCK_JOBS_FALLBACK=true
HTTP_TIMEOUT=8

# ── Email (optional) ──  empty = a mailto: draft opens in your email app
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── Privacy ──  true = every visitor gets a private database file (use this when you share the link)
# false = one shared database that survives a page refresh (your own laptop only)
PER_VISITOR_DATA=true
VISITOR_TTL_HOURS=6

# ── Database ──  empty = SQLite file. PostgreSQL turns off per-visitor privacy, so add login first.
DATABASE_URL=
